---
// Hlavička webu: logo, hamburger menu (čisté CSS) a přepínač režimu.
import site from '../data/site.json';
import Nav from './Nav.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header">
	<div class="container site-header__inner">
		<a href="/" class="site-header__logo">
			<span class="site-header__logo-mark" aria-hidden="true">K</span>
			{site.title}
		</a>

		<div class="site-header__theme">
			<ThemeToggle />
		</div>

		<!-- Skrytý checkbox řídí otevření menu přes selektor :checked ~ -->
		<input type="checkbox" id="menu-toggle" class="site-header__toggle" aria-controls="site-nav" />
		<label for="menu-toggle" class="site-header__burger">
			<span class="site-header__burger-lines" aria-hidden="true"></span>
			<span class="sr-only">Otevřít nebo zavřít menu</span>
		</label>

		<div class="site-header__nav" id="site-nav">
			<Nav />
		</div>
	</div>
</header>
