---
// Přepínač světlého / tmavého režimu. Volba se ukládá do localStorage.
---

<button type="button" class="theme-toggle" data-theme-toggle aria-label="Přepnout tmavý režim" aria-pressed="false">
	<svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" aria-hidden="true">
		<path fill="currentColor" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
	</svg>
	<svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" aria-hidden="true">
		<circle cx="12" cy="12" r="5" fill="currentColor"></circle>
		<path
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"
		></path>
	</svg>
</button>

<script>
	// Tento skript Astro zabalí a spustí v prohlížeči (klientská interaktivita).
	const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
	const root = document.documentElement;

	function currentTheme() {
		// data-theme nastavuje malý inline skript v BaseLayout ještě před vykreslením
		return root.dataset.theme === 'dark' ? 'dark' : 'light';
	}

	function applyTheme(theme: string) {
		root.dataset.theme = theme;
		button?.setAttribute('aria-pressed', String(theme === 'dark'));
	}

	applyTheme(currentTheme());

	button?.addEventListener('click', () => {
		const next = currentTheme() === 'dark' ? 'light' : 'dark';
		applyTheme(next);
		try {
			localStorage.setItem('theme', next);
		} catch {
			// localStorage nemusí být dostupný (např. anonymní okno), web funguje dál
		}
	});
</script>
