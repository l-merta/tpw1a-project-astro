---
// Patička webu. Aktuální rok se dopočítá při generování stránky.
import courseData from '../data/courses.json';
import site from '../data/site.json';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container">
		<div class="site-footer__grid">
			<section>
				<h2 class="site-footer__title">{site.title}</h2>
				<p>{site.description}</p>
			</section>
			<nav aria-label="Kategorie kurzů">
				<h2 class="site-footer__title">Kategorie</h2>
				<ul class="site-footer__list" role="list">
					{
						courseData.categories.map((category) => (
							<li>
								<a class="site-footer__link" href={`/kurzy/?kategorie=${category.id}`}>
									{category.name}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
			<section>
				<h2 class="site-footer__title">Kontakt</h2>
				<address>
					<ul class="site-footer__list" role="list">
						<li><a class="site-footer__link" href="mailto:info@kurzovna.example">info@kurzovna.example</a></li>
						<li>Hradecká 1249/6, Hradec Králové</li>
					</ul>
				</address>
			</section>
		</div>
		<p class="site-footer__bottom">
			&copy; {year} {site.title}. Školní projekt KIT/TPW1A, obsah je smyšlený.
		</p>
	</div>
</footer>
