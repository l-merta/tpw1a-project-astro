---
// Úvodní stránka: hero banner, doporučené kurzy a přehled kategorií.
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CourseCard from '../components/CourseCard.astro';
import Hero from '../components/Hero.astro';
import courseData from '../data/courses.json';

const { courses, categories } = courseData;

// Pomocná funkce: id kategorie -> její název
const categoryName = (id: string) => categories.find((category) => category.id === id)?.name ?? id;

const featuredCourses = courses.filter((course) => course.featured);
const totalHours = courses.reduce((sum, course) => sum + course.duration, 0);
const lecturers = new Set(courses.map((course) => course.lecturer)).size;
---

<BaseLayout>
	<Hero
		variant="large"
		eyebrow="Katalog kurzů"
		title="Naučte se tvořit web, programovat a pracovat s daty"
		text="Vyberte si z kurzů pro začátečníky i pokročilé. Online, prezenčně nebo kombinovaně, vždy s lektorem, který vám pomůže."
	>
		<Fragment slot="actions">
			<Button href="/kurzy/">Prohlédnout kurzy</Button>
			<Button href="/faq/" variant="secondary">Jak výuka probíhá</Button>
		</Fragment>
		<ul class="hero__stats" role="list" slot="aside">
			<li class="hero__stat">
				<span class="hero__stat-value">{courses.length}</span>
				<span class="hero__stat-label">kurzů</span>
			</li>
			<li class="hero__stat">
				<span class="hero__stat-value">{totalHours}</span>
				<span class="hero__stat-label">hodin výuky</span>
			</li>
			<li class="hero__stat">
				<span class="hero__stat-value">{lecturers}</span>
				<span class="hero__stat-label">lektorů</span>
			</li>
		</ul>
	</Hero>

	<section class="section" aria-labelledby="featured-title">
		<div class="container">
			<header class="section__header">
				<h2 class="section__title" id="featured-title">Doporučené kurzy</h2>
				<a href="/kurzy/">Všechny kurzy →</a>
			</header>
			<div class="course-grid course-grid--featured">
				{
					featuredCourses.map((course) => (
						<CourseCard course={course} categoryName={categoryName(course.category)} featured />
					))
				}
			</div>
		</div>
	</section>

	<section class="section section--alt" aria-labelledby="categories-title">
		<div class="container">
			<header class="section__header">
				<h2 class="section__title" id="categories-title">Kategorie</h2>
			</header>
			<ul class="course-grid" role="list">
				{
					categories.map((category) => {
						const count = courses.filter((course) => course.category === category.id).length;
						return (
							<li class="info-box">
								<h3>{category.name}</h3>
								<p class="text-muted">{count} {count === 1 ? 'kurz' : count < 5 ? 'kurzy' : 'kurzů'}</p>
								<Button href={`/kurzy/?kategorie=${category.id}`} variant="ghost" size="small">
									Zobrazit kurzy
								</Button>
							</li>
						);
					})
				}
			</ul>
		</div>
	</section>
</BaseLayout>
