---
// Detail kurzu. getStaticPaths() při buildu vytvoří jednu HTML stránku
// pro každý kurz v courses.json (např. /kurzy/html-css-zaklady/).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Accordion from '../../components/Accordion.astro';
import Badge from '../../components/Badge.astro';
import Button from '../../components/Button.astro';
import CourseCard from '../../components/CourseCard.astro';
import EnrollForm from '../../components/EnrollForm.astro';
import Hero from '../../components/Hero.astro';
import Modal from '../../components/Modal.astro';
import courseData from '../../data/courses.json';
import site from '../../data/site.json';
import { formatPrice } from '../../utils/format';

export function getStaticPaths() {
	return courseData.courses.map((course) => ({
		params: { slug: course.slug },
		props: { course },
	}));
}

const { course } = Astro.props;
const { categories, courses } = courseData;
const categoryName = (id: string) => categories.find((category) => category.id === id)?.name ?? id;
const levelName = site.levels[course.level as keyof typeof site.levels];

const images = import.meta.glob<{ default: ImageMetadata }>('../../assets/*.jpg', { eager: true });
const image = images[`../../assets/${course.image}`]?.default;

// Podobné kurzy = stejná kategorie, kromě aktuálního kurzu
const related = courses.filter((item) => item.category === course.category && item.slug !== course.slug);
---

<BaseLayout title={course.title} description={course.perex} image={image}>
	<Hero variant="compact" eyebrow={categoryName(course.category)} title={course.title} text={course.perex} />

	<section class="section">
		<div class="container course-detail">
			{image && <Image src={image} alt="" class="course-detail__image" width={960} height={480} />}

			<div class="course-detail__content">
				<article>
					<h2 class="course-detail__heading">O kurzu</h2>
					<p>{course.description}</p>
				</article>

				<section aria-labelledby="topics-title">
					<h2 class="course-detail__heading" id="topics-title">Co se naučíte</h2>
					<ul class="course-detail__topics" role="list">
						{course.topics.map((topic) => <li class="course-detail__topic">{topic}</li>)}
					</ul>
				</section>

				<section aria-labelledby="syllabus-title">
					<h2 class="course-detail__heading" id="syllabus-title">Osnova</h2>
					{
						course.topics.map((topic, index) => (
							<Accordion title={`${index + 1}. blok: ${topic}`} variant="plain" open={index === 0}>
								<p>
									Přibližně {Math.round(course.lessons / course.topics.length)} lekce s praktickými úkoly a
									konzultací s lektorem.
								</p>
							</Accordion>
						))
					}
				</section>
			</div>

			<aside class="course-detail__sidebar" aria-label="Informace o kurzu">
				<div class="info-box">
					<p class="info-box__price">{formatPrice(course.price)}</p>
					<dl class="info-box__facts">
						<dt class="info-box__term">Úroveň</dt>
						<dd class="info-box__value">
							<Badge variant={course.level as 'beginner' | 'intermediate' | 'advanced'}>{levelName}</Badge>
						</dd>
						<dt class="info-box__term">Forma</dt>
						<dd class="info-box__value">{course.format}</dd>
						<dt class="info-box__term">Rozsah</dt>
						<dd class="info-box__value">{course.lessons} lekcí, {course.duration} h</dd>
						<dt class="info-box__term">Lektor</dt>
						<dd class="info-box__value">{course.lecturer}</dd>
					</dl>
					<Button block data-modal-open="enroll-modal">Přihlásit se na kurz</Button>
					<Button href="/kurzy/" variant="ghost" block>← Zpět na všechny kurzy</Button>
				</div>
			</aside>
		</div>
	</section>

	{
		related.length > 0 && (
			<section class="section section--alt" aria-labelledby="related-title">
				<div class="container">
					<header class="section__header">
						<h2 class="section__title" id="related-title">Podobné kurzy</h2>
					</header>
					<div class="course-grid">
						{related.map((item) => (
							<CourseCard course={item} categoryName={categoryName(item.category)}>
								<Button slot="footer" href={`/kurzy/${item.slug}/`} variant="secondary" size="small">
									Detail
								</Button>
							</CourseCard>
						))}
					</div>
				</div>
			</section>
		)
	}

	<Modal id="enroll-modal" title={`Přihláška: ${course.title}`}>
		<EnrollForm courseTitle={course.title} idPrefix="enroll" />
	</Modal>
</BaseLayout>
