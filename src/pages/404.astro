---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Hero from '../components/Hero.astro';
---

<BaseLayout title="Stránka nenalezena" description="Požadovaná stránka neexistuje.">
	<Hero title="Stránka nenalezena" text="Tato stránka neexistuje. Možná byla přesunuta nebo jste udělali překlep v adrese.">
		<Button slot="actions" href="/">Zpět na úvod</Button>
	</Hero>
</BaseLayout>
